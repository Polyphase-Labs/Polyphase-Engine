; Example PICA200 vertex shader

; Uniforms
.fvec WorldViewMtx[4]
.fvec NormalMtx[4]
.fvec ProjMtx[4]
.fvec WorldMtx[4]
.fvec UvOffsetScale0
.fvec UvOffsetScale1
.fvec UvMaps
.fvec UvSources
.fvec UniformColor
.fvec BoneMtx[4 * 16]

; Constants
.constf myconst(0.0, 1.0, -1.0, 0.1)
.constf myconst2(0.3, 0.003922, 4.0, 0.0)
.constf uvSrcConst(1.0, 2.0, 3.0, 4.0)
.alias  zeros myconst.xxxx ; Vector full of zeros
.alias  ones  myconst.yyyy ; Vector full of ones
.alias  half  myconst.wwww
.alias  rcp255 myconst2.yyyy ; 1/255.0

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outclr color
.out outview view
.out outnq normalquat

; Inputs (defined as aliases for convenience)
.alias inpos v0
.alias intc0 v1
.alias intc1 v2
.alias innrm v3
.alias inbid v4
.alias inbwt v5

.proc main
	; Force the w component of inpos to be 1.0
	mov r0.xyz, inpos
	mov r0.w,   ones

	; Using the bone index, look up the correct matrix.
	; Only single bone influence for now...
	mov r2.x, inbid.x
	mov r3.x, myconst2.z
	mul r2.x, r2.x, r3.x
	mova a0.x, r2

	dp4 r2.x, BoneMtx[a0.x + 0], r0
	dp4 r2.y, BoneMtx[a0.x + 1], r0
	dp4 r2.z, BoneMtx[a0.x + 2], r0
	dp4 r2.w, BoneMtx[a0.x + 3], r0

	; r1 = WorldViewMtx * inpos
	dp4 r1.x, WorldViewMtx[0], r2
	dp4 r1.y, WorldViewMtx[1], r2
	dp4 r1.z, WorldViewMtx[2], r2
	dp4 r1.w, WorldViewMtx[3], r2
	
	; outview = -r1
	mov outview, -r1
	
	; outpos = ProjMtx * r1
	dp4 outpos.x, ProjMtx[0], r1
	dp4 outpos.y, ProjMtx[1], r1
	dp4 outpos.z, ProjMtx[2], r1
	dp4 outpos.w, ProjMtx[3], r1

	; Compute world position for world-space UV projection (r2 is post-skinning)
	dp4 r4.x, WorldMtx[0], r2
	dp4 r4.y, WorldMtx[1], r2
	dp4 r4.z, WorldMtx[2], r2
	dp4 r4.w, WorldMtx[3], r2

	; Compute approximate world-space normal: bone-transform innrm into r5,
	; then world-transform into r6 (avoids touching r2 which holds skinned pos).
	dp3 r5.x, BoneMtx[a0.x + 0], innrm
	dp3 r5.y, BoneMtx[a0.x + 1], innrm
	dp3 r5.z, BoneMtx[a0.x + 2], innrm
	dp3 r6.x, WorldMtx[0], r5
	dp3 r6.y, WorldMtx[1], r5
	dp3 r6.z, WorldMtx[2], r5
	; r13 = abs(world normal)
	max r13.x, r6.x, -r6.x
	max r13.y, r6.y, -r6.y
	max r13.z, r6.z, -r6.z

	; Pre-compute WorldAutoAxis UV into r12 (default = XY for Z-dominant)
	mov r12.x, r4.x
	mov r12.y, r4.y
	; If |n.x| >= |n.z|, switch to ZY (X-dominant default)
	cmp r13.x, ge, ge, r13.z
	ifc cmp.x
		mov r12.x, r4.z
		mov r12.y, r4.y
	.end
	; If |n.y| >= |n.x| AND |n.y| >= |n.z|, override with XZ (Y-dominant wins)
	cmp r13.yy, ge, ge, r13.xz
	ifc cmp.x
		ifc cmp.y
			mov r12.x, r4.x
			mov r12.y, r4.z
		.end
	.end

	; Copy UvSources into a temp register so it can be used as cmp src2
	; (PICA cmp requires src2 to be a temp register, not a constant uniform)
	mov r15, UvSources

	; --- UV channel 0 source selection (default: mesh) ---
	mov r10, intc0
	cmp uvSrcConst.xxxx, eq, eq, r15.xxxx
	ifc cmp.x
		mov r10.x, r4.x
		mov r10.y, r4.y
	.end
	cmp uvSrcConst.yyyy, eq, eq, r15.xxxx
	ifc cmp.x
		mov r10.x, r4.x
		mov r10.y, r4.z
	.end
	cmp uvSrcConst.zzzz, eq, eq, r15.xxxx
	ifc cmp.x
		mov r10.x, r4.y
		mov r10.y, r4.z
	.end
	cmp uvSrcConst.wwww, eq, eq, r15.xxxx
	ifc cmp.x
		mov r10.x, r12.x
		mov r10.y, r12.y
	.end

	; --- UV channel 1 source selection (default: mesh) ---
	mov r11, intc1
	cmp uvSrcConst.xxxx, eq, eq, r15.yyyy
	ifc cmp.x
		mov r11.x, r4.x
		mov r11.y, r4.y
	.end
	cmp uvSrcConst.yyyy, eq, eq, r15.yyyy
	ifc cmp.x
		mov r11.x, r4.x
		mov r11.y, r4.z
	.end
	cmp uvSrcConst.zzzz, eq, eq, r15.yyyy
	ifc cmp.x
		mov r11.x, r4.y
		mov r11.y, r4.z
	.end
	cmp uvSrcConst.wwww, eq, eq, r15.yyyy
	ifc cmp.x
		mov r11.x, r12.x
		mov r11.y, r12.y
	.end

	add r1, UvOffsetScale0.xyxy, r10.xyxy
	mul r1, UvOffsetScale0.zwzw, r1

	add r2, UvOffsetScale1.xyxy, r11.xyxy
	mul r2, UvOffsetScale1.zwzw, r2

	mov r3, UvMaps

	; Assign TC0
	cmp zeros, eq, eq, r3.x
	ifc cmp.x
		mov outtc0, r1
	.else
		mov outtc0, r2
	.end
	
	; Assign TC1
	cmp zeros, eq, eq, r3.y
	ifc cmp.x
		mov outtc1, r1
	.else
		mov outtc1, r2
	.end

	; Assign TC2
	cmp zeros, eq, eq, r3.z
	ifc cmp.x
		mov outtc2, r1
	.else
		mov outtc2, r2
	.end

	mov outclr, UniformColor

	; Transform normal using inv transpose of ModelViewMtx (NormalMtx)
	; But first apply bone transformation
	dp3 r2.x, BoneMtx[a0.x + 0], innrm
	dp3 r2.y, BoneMtx[a0.x + 1], innrm
	dp3 r2.z, BoneMtx[a0.x + 2], innrm

	dp3 r14.x, NormalMtx[0], r2
	dp3 r14.y, NormalMtx[1], r2
	dp3 r14.z, NormalMtx[2], r2
	dp3 r6.x, r14, r14
	rsq r6.x, r6.x
	mul r14.xyz, r14.xyz, r6.x

	mov r0, myconst.yxxx
	add r4, ones, r14.z
	mul r4, half, r4
	cmp zeros, ge, ge, r4.x
	rsq r4, r4.x
	mul r5, half, r14
	jmpc cmp.x, degenerate

	rcp r0.z, r4.x
	mul r0.xy, r5, r4

degenerate:
	mov outnq, r0

	; We're finished
	end
.end
