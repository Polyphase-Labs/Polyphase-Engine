#---------------------------------------------------------------------------------
# Clear the implicit built in rules
#---------------------------------------------------------------------------------
.SUFFIXES:
.SECONDARY:
#---------------------------------------------------------------------------------
export AS	:=	$(PREFIX)as
export CC	:=	$(PREFIX)clang
export CXX	:=	$(PREFIX)clang++
export AR	:=	$(PREFIX)ar
export STRIP	:=	$(PREFIX)strip
export NM	:=	$(PREFIX)nm
export RANLIB	:=	$(PREFIX)ranlib

# MAC_ARCH selects the Mach-O slices: native (default, = uname -m), arm64,
# x86_64 or universal (arm64 + x86_64 fat objects/archives/executables).
# Command line or environment; propagates to every sub-make (Engine, Bullet,
# Assimp, the inner -C $(BUILD) pass) through MAKEFLAGS like BUILD_SUFFIX.
MAC_ARCH ?= native
ifeq ($(MAC_ARCH),native)
MAC_ARCH_RESOLVED := $(shell uname -m)
else
MAC_ARCH_RESOLVED := $(MAC_ARCH)
endif
ifeq ($(filter arm64 x86_64 universal,$(MAC_ARCH_RESOLVED)),)
$(error MAC_ARCH must be native, arm64, x86_64 or universal (got '$(MAC_ARCH)'))
endif
ifeq ($(MAC_ARCH_RESOLVED),universal)
MAC_ARCHFLAGS := -arch arm64 -arch x86_64
else
MAC_ARCHFLAGS := -arch $(MAC_ARCH_RESOLVED)
endif
MACHDEP	:=	$(MAC_ARCHFLAGS) -mmacosx-version-min=12.0

ifeq ($(V),1)
    SILENTMSG := @true
    SILENTCMD :=
else
    SILENTMSG := @echo
    SILENTCMD := @
endif

#---------------------------------------------------------------------------------
%.a:
#---------------------------------------------------------------------------------
	$(SILENTMSG) $(notdir $@)
	$(SILENTCMD)rm -f $@
	$(SILENTCMD)$(AR) -rcs $@ $^

#---------------------------------------------------------------------------------
%.o: %.cpp
	$(SILENTMSG) $(notdir $<)
	$(SILENTCMD)$(CXX) -MMD -MP -MF $(DEPSDIR)/$*.d $(CXXFLAGS) -c $< -o $@ $(ERROR_FILTER)

#---------------------------------------------------------------------------------
%.o: %.c
	$(SILENTMSG) $(notdir $<)
	$(SILENTCMD)$(CC) -MMD -MP -MF $(DEPSDIR)/$*.d $(CFLAGS) -c $< -o $@ $(ERROR_FILTER)

#---------------------------------------------------------------------------------
%.o: %.mm
	$(SILENTMSG) $(notdir $<)
	$(SILENTCMD)$(CXX) -MMD -MP -MF $(DEPSDIR)/$*.d $(OBJCXXFLAGS) -c $< -o $@ $(ERROR_FILTER)

#---------------------------------------------------------------------------------
# TARGET is the name of the output
# BUILD is the directory where object files & intermediate files will be placed
# SOURCES is a list of directories containing source code
# INCLUDES is a list of directories containing extra header files
#---------------------------------------------------------------------------------
TARGET		:=	Polyphase
BUILD		:=	Intermediate/Mac/Editor
SOURCES		:=	Source \
				Generated
INCLUDES	:=	Source ../Engine/Source  ../Engine/Source/Editor ../Engine/Source/Engine ../External ../External/Bullet $(VULKAN_SDK)/include \
				../External/Assimp ../External/IrrXML ../External/Zlib
OUTPUT_DIR	:=	$(CURDIR)/Build/Mac
ARCH_INTERMEDIATE_ROOT	:=	$(CURDIR)/Intermediate/Mac

#---------------------------------------------------------------------------------
# options for code generation
#---------------------------------------------------------------------------------

CFLAGS	= -g -O2 -Wall $(MACHDEP) -DEDITOR=1 -DPLATFORM_MAC=1 -DAPI_VULKAN=1 $(INCLUDE)

# W1: shared-engine editor build (libPolyphaseEditor.dylib). Run
# `make -f Makefile_Mac_Editor POLYPHASE_SHARED=1`. POLYPHASE_DLL_CONSUMER=1
# turns on Standalone/Source/Main.cpp's exe-side entry-point + hook auto-register.
ifneq ($(strip $(POLYPHASE_SHARED)),)
CFLAGS		+=	-DPOLYPHASE_DLL_CONSUMER=1
BUILD		:=	Intermediate/Mac/EditorShared
LINK_ENGINE	:=	-lPolyphaseEditor
ENGINE_TARGET	:=	editor-shared
ENGINE_LIB_NAME	:=	libPolyphaseEditor.dylib
else
LINK_ENGINE	:=	-lEngineEditor
ENGINE_TARGET	:=
ENGINE_LIB_NAME	:=	libEngineEditor.a
endif

CXXFLAGS	=	$(CFLAGS) -std=gnu++17
OBJCXXFLAGS	=	$(CXXFLAGS) -ObjC++ -fobjc-arc

LDFLAGS	=	-g $(MACHDEP) -Wl,-map,$(notdir $@).map -rdynamic -Wl,-rpath,@loader_path -Wl,-rpath,@loader_path/../Frameworks -Wl,-rpath,$(VULKAN_SDK)/lib

#---------------------------------------------------------------------------------
# any extra libraries we wish to link with the project
#
# Shared mode: the engine .so already statically contains shaderc, spirv-cross,
# Assimp, Bullet, libgit2, ssl, crypto. Re-linking those static archives into the
# editor exe both duplicates them and breaks (their symbols are hidden in the
# .so, so the linker rejects re-exporting them — `hidden symbol ... in ... is
# referenced by DSO`). In shared mode we only link the engine .so plus the
# system-provided shared libs the exe genuinely needs at its own boundary.
#---------------------------------------------------------------------------------
ifneq ($(strip $(POLYPHASE_SHARED)),)
LIBS	:=	$(LINK_ENGINE) -lvulkan -lpthread -lm -ldl -framework Cocoa -framework Metal -framework QuartzCore -framework IOKit -framework GameController -framework AudioToolbox -framework CoreAudio -framework Security -framework CoreFoundation -framework Carbon
else
LIBS	:=	$(LINK_ENGINE) -lspirv-cross-core -lshaderc_combined -lvulkan -lAssimp -lBullet -lgit2 -liconv -framework GSS -lpthread -lm -framework Cocoa -framework Metal -framework QuartzCore -framework IOKit -framework GameController -framework AudioToolbox -framework CoreAudio -framework Security -framework CoreFoundation -framework Carbon
endif

#---------------------------------------------------------------------------------
# list of directories containing libraries, this must be the top level containing
# include and lib
#---------------------------------------------------------------------------------
LIBDIRS	:= $(VULKAN_SDK) ../External/Assimp

#---------------------------------------------------------------------------------
# no real need to edit anything past this point unless you need to add additional
# rules for different file extensions
#---------------------------------------------------------------------------------
ifneq ($(notdir $(BUILD)),$(notdir $(CURDIR)))
#---------------------------------------------------------------------------------

export VPATH	:=	$(foreach dir,$(SOURCES),$(CURDIR)/$(dir))

export DEPSDIR	:=	$(CURDIR)/$(BUILD)

#---------------------------------------------------------------------------------
# automatically build a list of object files for our project
#---------------------------------------------------------------------------------
CFILES			:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.c)))
CPPFILES		:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.cpp)))
MMFILES			:=	$(foreach dir,$(SOURCES),$(notdir $(wildcard $(dir)/*.mm)))

#---------------------------------------------------------------------------------
# use CXX for linking C++ projects, CC for standard C
#---------------------------------------------------------------------------------
ifeq ($(strip $(CPPFILES)),)
	export LD	:=	$(CC)
else
	export LD	:=	$(CXX)
endif

export OFILES_SOURCES := $(CPPFILES:.cpp=.o) $(CFILES:.c=.o) $(MMFILES:.mm=.o)
export OFILES := $(OFILES_SOURCES)

#---------------------------------------------------------------------------------
# build a list of include paths
#---------------------------------------------------------------------------------
export INCLUDE	:=	$(foreach dir,$(INCLUDES),-I$(CURDIR)/$(dir)) \
					$(foreach dir,$(LIBDIRS),-I$(dir)/include) \
					-I$(CURDIR)/$(BUILD)

#---------------------------------------------------------------------------------
# build a list of library paths
#---------------------------------------------------------------------------------
export LIBPATHS	:=	$(foreach dir,$(LIBDIRS),-L$(dir)/lib) \
					-L$(CURDIR)/../External/Assimp/Build/Mac \
					-L$(CURDIR)/../External/Bullet/Build/Mac \
					-L$(CURDIR)/../Engine/Build/Mac \
					-L$(CURDIR)/../Engine/External/libgit2/build

export OUTPUT	:=	$(OUTPUT_DIR)/$(TARGET)Editor
export ENGINE_LIB := $(CURDIR)/../Engine/Build/Mac/$(ENGINE_LIB_NAME)
# Only set POLYPHASE_EDITOR for the static-lib path; the shared path passes
# POLYPHASE_EDITOR_SHARED into MakeEngine which already implies EDITOR=1.
ifeq ($(strip $(POLYPHASE_SHARED)),)
export POLYPHASE_EDITOR	:= 1
endif
.PHONY: $(BUILD) clean

#---------------------------------------------------------------------------------
all: $(BUILD)

# Arch stamp: everything under $(OUTPUT_DIR) and $(ARCH_INTERMEDIATE_ROOT) is
# only valid for the MAC_ARCH it was compiled for. On a mismatch wipe both so a
# thin archive can never be linked into a universal binary or vice versa. A
# missing stamp on an existing tree means arm64 (the only arch any tree could
# have been built for before MAC_ARCH existed), so no forced rebuild there.
# Prerequisite of the first-running targets below so nothing races the rm -rf
# under -j.
MAC_ARCH_STAMP := $(OUTPUT_DIR)/.mac_arch
.PHONY: ArchStamp
ArchStamp:
	@have="arm64"; [ -f "$(MAC_ARCH_STAMP)" ] && have="$$(cat "$(MAC_ARCH_STAMP)")"; \
	if [ "$$have" != "$(MAC_ARCH_RESOLVED)" ] && { [ -d "$(OUTPUT_DIR)" ] || [ -d "$(ARCH_INTERMEDIATE_ROOT)" ]; }; then \
	    echo "MAC_ARCH $$have -> $(MAC_ARCH_RESOLVED): cleaning $(OUTPUT_DIR) $(ARCH_INTERMEDIATE_ROOT)"; \
	    rm -rf "$(OUTPUT_DIR)" "$(ARCH_INTERMEDIATE_ROOT)"; \
	fi; \
	mkdir -p "$(OUTPUT_DIR)"; echo "$(MAC_ARCH_RESOLVED)" > "$(MAC_ARCH_STAMP)"

OutputDirs: ArchStamp
	[ -d $(OUTPUT_DIR) ] || mkdir -p $(OUTPUT_DIR)
	[ -d $(BUILD) ] || mkdir -p $(BUILD)

MakeEngine: ArchStamp
	$(MAKE) --no-print-directory -C $(CURDIR)/../Engine -f $(CURDIR)/../Engine/Makefile_Mac $(ENGINE_TARGET)

$(BUILD): OutputDirs MakeEngine
	[ -d $@ ] || mkdir -p $@
	$(MAKE) --no-print-directory -C $(BUILD) -f $(CURDIR)/$(firstword $(MAKEFILE_LIST))
ifneq ($(strip $(POLYPHASE_SHARED)),)
	cp $(ENGINE_LIB) $(OUTPUT_DIR)/$(ENGINE_LIB_NAME)
endif
	@# Mirror the Windows post-build copy: stash the latest editor binary at
	@# the repo root so callers (Tools/CI/run_local_verify.sh, dev shortcuts)
	@# always have a stable path to the freshest build. Suppress errors so a
	@# broken build doesn't mask the real failure with a copy error.
	@cp -f "$(OUTPUT_DIR)/$(TARGET)Editor" "$(CURDIR)/.." 2>/dev/null || true

#---------------------------------------------------------------------------------
clean:
	@echo clean ...
	@rm -fr $(BUILD) $(OUTPUT_DIR)
	@export EDITOR=1
	@$(MAKE) clean --no-print-directory -C $(CURDIR)/../Engine -f $(CURDIR)/../Engine/Makefile_Mac

#---------------------------------------------------------------------------------
else

#---------------------------------------------------------------------------------
# main targets
#---------------------------------------------------------------------------------
# Explicit link rule: the Mach-O has no extension, and an extension-less `%:`
# pattern rule would match every target under make 3.81.
$(OUTPUT): $(OFILES) $(ENGINE_LIB)
	$(SILENTMSG) linking ... $(notdir $@)
	$(SILENTCMD)$(LD) $(OFILES) $(LDFLAGS) $(LIBPATHS) $(LIBS) -o $@

$(ENGINE_LIB): 

$(OFILES_SOURCES) : 

-include $(DEPSDIR)/*.d

#---------------------------------------------------------------------------------
endif
#---------------------------------------------------------------------------------
